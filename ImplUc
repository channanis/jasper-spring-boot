package com.sgma.mobile.dto;

import java.time.LocalDate;

public record ContratMobileSourceData(
        Long numBas, Integer numCat,
        String modPBas, LocalDate deffBas, LocalDate datAnnul, LocalDate daSuspen, String nucptBan,
        Double primeBas, Double ppi, Double pui, Double capBas, String nantissement,
        String libelle, String libelleClient,
        String tnomAss, String nomAss, String preAss, LocalDate dnaisAss, String cin,
        String perEmailMobil, String numTelMobil
) {}
package com.sgma.mobile.repository;

import com.sgma.mobile.dto.ContratMobileSourceData;
import com.sgma.mobile.entity.Base;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;

import java.util.Optional;

public interface BaseRepository extends JpaRepository<Base, Long> {

    @Query("""
            select new com.sgma.mobile.dto.ContratMobileSourceData(
                b.numBas, b.numCat,
                b.modPBas, b.deffBas, b.datAnnul, b.daSuspen, b.nucptBan,
                b.primeBas, b.ppi, b.pui, b.capBas, b.nantissement,
                c.libelle, c.libelleClient,
                a.tnomAss, a.nomAss, a.preAss, a.dnaisAss, a.cin,
                a.perEmailMobil, a.numTelMobil
            )
            from Base b
            join Assure a on a.numAss = b.numAss
            join Categori c on c.numCat = b.numCat
            where b.numBas = :nadh
              and b.numCat = :numCat
              and upper(replace(replace(a.cin, ' ', ''), '.', '')) = upper(replace(replace(:cin, ' ', ''), '.', ''))
              and b.deffBas is not null
              and b.datAnnul is null
            """)
    Optional<ContratMobileSourceData> findContratMobileByCinAndNumCatAndNadh(
            @Param("cin") String cin,
            @Param("numCat") Integer numCat,
            @Param("nadh") Long nadh);
}
