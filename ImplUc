package com.sgma.mobile.entity;

import jakarta.persistence.*;
import lombok.*;
import java.time.LocalDate;

@Entity
@Table(name = "BASE")
@Data @NoArgsConstructor @AllArgsConstructor @Builder
public class Base {

    @Id @Column(name = "NUMBAS")
    private Long numBas;

    @Column(name = "NUMCAT") private Integer numCat;
    @Column(name = "NUMASS") private Long numAss;
    @Column(name = "MODPBAS") private String modPBas;
    @Column(name = "DEFFBAS") private LocalDate deffBas;
    @Column(name = "DATANNUL") private LocalDate datAnnul;
    @Column(name = "DASUSPEN") private LocalDate daSuspen;
    @Column(name = "NUCPTBAN", length = 24) private String nucptBan;
    @Column(name = "PRIMEBAS") private Double primeBas;
    @Column(name = "PPI") private Double ppi;
    @Column(name = "PUI") private Double pui;
    @Column(name = "CAPBAS") private Double capBas;
    @Column(name = "NANTISSEMENT") private String nantissement;
}

package com.sgma.mobile.entity;

import jakarta.persistence.*;
import lombok.*;

import java.time.LocalDate;

@Entity
@Table(name = "ASSURE")
