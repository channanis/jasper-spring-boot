<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="attestation_versement_groupe"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30"
              uuid="b2c3d4e5-f6a7-48b9-0c1d-2e3f4a5b6c7d">

    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>

    <!-- ===================== PARAMETRES ===================== -->
    <!-- Champs du JSON "ATTESTATION_VERSEMENT_GROUPE" : pas de dateEffet, mais un "pays",
         et "numeroPolice" à la place de "numeroContrat". -->
    <parameter name="titre" class="java.lang.String"/>
    <parameter name="nom" class="java.lang.String"/>
    <parameter name="prenom" class="java.lang.String"/>
    <parameter name="adresse1" class="java.lang.String"/>
    <parameter name="adresse2" class="java.lang.String"/>
    <parameter name="ville" class="java.lang.String"/>
    <parameter name="pays" class="java.lang.String"/>
    <parameter name="numeroAdhesion" class="java.lang.String"/>
    <parameter name="libelleContrat" class="java.lang.String"/>
    <parameter name="numeroPolice" class="java.lang.String"/>
    <parameter name="dateSysteme" class="java.lang.String"/>

    <!-- ===================== CHAMPS (EcheanceVersement) ===================== -->
    <field name="echeance" class="java.lang.String"/>
    <field name="montantVersement" class="java.math.BigDecimal"/>
    <field name="dateEncaissement" class="java.time.LocalDate"/>

    <!-- ===================== EN-TETE DE PAGE ===================== -->
    <pageHeader>
        <band height="270">
            <!-- Logo -->
            <image>
                <reportElement x="0" y="0" width="180" height="50"/>
                <imageExpression><![CDATA[getClass().getResourceAsStream("/templates/images/logo.png")]]></imageExpression>
            </image>

            <!-- Bloc destinataire (haut droit) : nom + adresse1 + adresse2 + ville + pays -->
            <textField>
                <reportElement x="330" y="0" width="205" height="15"/>
                <textFieldExpression><![CDATA[($P{titre} == null ? "" : $P{titre} + " ") + $P{nom} + " " + $P{prenom}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="15" width="205" height="15"/>
                <textFieldExpression><![CDATA[$P{adresse1}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="30" width="205" height="15"/>
                <textFieldExpression><![CDATA[$P{adresse2}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="45" width="205" height="15"/>
                <textFieldExpression><![CDATA[$P{ville}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="60" width="205" height="15"/>
                <textFieldExpression><![CDATA[$P{pays}]]></textFieldExpression>
            </textField>

            <!-- Votre interlocuteur -->
            <staticText>
                <reportElement x="0" y="55" width="200" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Votre interlocuteur]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="72" width="250" height="14"/>
                <text><![CDATA[Direction Relation Clients]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="86" width="300" height="14"/>
                <text><![CDATA[Tél : 05 22 26 36 36 (du lundi au vendredi de 8h à 16h30)]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="100" width="300" height="14"/>
                <text><![CDATA[E-mail : relationclient.lmv@lamarocainevie.com]]></text>
            </staticText>

            <!-- Où adresser votre courrier -->
            <staticText>
                <reportElement x="0" y="122" width="250" height="14"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Où adresser votre courrier]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="138" width="400" height="14"/>
                <textElement><font isUnderline="true"/></textElement>
                <text><![CDATA[ventilationcotis.retraite@lamarocainevie.com]]></text>
            </staticText>

            <!-- Références du dossier – libellé du contrat -->
            <textField>
                <reportElement x="0" y="165" width="400" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Références du dossier – " + $P{libelleContrat}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="15" y="184" width="300" height="14"/>
                <textFieldExpression><![CDATA["Adhésion N° : " + $P{numeroAdhesion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="184" width="155" height="14"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Casablanca, le " + $P{dateSysteme}]]></textFieldExpression>
            </textField>

            <!-- Objet -->
            <staticText>
                <reportElement x="0" y="215" width="300" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[OBJET :        ATTESTATION DE VERSEMENT (*)]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="240" width="535" height="14"/>
                <text><![CDATA[Cher Assuré,]]></text>
            </staticText>
        </band>
    </pageHeader>

    <!-- ===================== CORPS DE LETTRE + EN-TETE DE TABLEAU ===================== -->
    <columnHeader>
        <band height="75">
            <staticText>
                <reportElement x="0" y="0" width="535" height="14"/>
                <text><![CDATA[Par suite]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="14" width="535" height="30"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["de votre demande, nous vous prions de trouver, ci-après, l'état des versements effectués dans le cadre de votre contrat " + $P{libelleContrat} + " N° " + $P{numeroPolice} + " :"]]></textFieldExpression>
            </textField>

            <!-- En-tête du tableau des échéances -->
            <rectangle>
                <reportElement x="0" y="55" width="535" height="20" backcolor="#D9D9D9" mode="Opaque"/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="55" width="178" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Echéance]]></text>
            </staticText>
            <staticText>
                <reportElement x="178" y="55" width="179" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Montant Versement]]></text>
            </staticText>
            <staticText>
                <reportElement x="357" y="55" width="178" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Date d'Encaissement]]></text>
            </staticText>
            <line>
                <reportElement x="178" y="55" width="0" height="20"/>
            </line>
            <line>
                <reportElement x="357" y="55" width="0" height="20"/>
            </line>
        </band>
    </columnHeader>

    <!-- ===================== DETAIL (une ligne par échéance) ===================== -->
    <detail>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="20"/>
            </rectangle>
            <line>
                <reportElement x="178" y="0" width="0" height="20"/>
            </line>
            <line>
                <reportElement x="357" y="0" width="0" height="20"/>
            </line>

            <textField>
                <reportElement x="0" y="0" width="178" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{echeance}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="178" y="0" width="179" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{montantVersement}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="357" y="0" width="178" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{dateEncaissement} == null ? null : java.sql.Date.valueOf($F{dateEncaissement})]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ===================== PIED DE PAGE (coordonnées société) ===================== -->
    <pageFooter>
        <band height="45">
            <line>
                <reportElement x="0" y="0" width="535" height="0"/>
            </line>
            <staticText>
                <reportElement x="0" y="6" width="180" height="36"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[37, Boulevard Moulay Youssef
Casablanca
Maroc]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="6" width="180" height="36"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[Tél : (212) 05 22 43 11 00
Fax : (212) 05 22 26 19 71
lamarocainevie@lamarocainevie.com
www.lamarocainevie.com]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="6" width="175" height="36"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[Entreprise régie par la loi n°17-99 portant code des assurances
Société Anonyme au Capital de 231 750 000 DH - RC 36675
Patente 35504343 - CNSS 177 5652]]></text>
            </staticText>
        </band>
    </pageFooter>

    <!-- ===================== BAS DE LETTRE + SIGNATURE (une seule fois, en fin de rapport) ===================== -->
    <summary>
        <band height="220">
            <staticText>
                <reportElement x="0" y="10" width="535" height="14"/>
                <textElement><font isItalic="true" size="9"/></textElement>
                <text><![CDATA[(*) Sauf erreur ou omission de notre part.]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="30" width="535" height="28"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Pour tous renseignements complémentaires, nous vous invitons à contacter la Direction Relations Clients au 05 22 26 36 36 (du lundi au vendredi de 8h à 16h30).]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="62" width="535" height="28"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[En vous remerciant de votre confiance, nous vous prions d'agréer, Cher Assuré, nos meilleures salutations.]]></text>
            </staticText>

            <staticText>
                <reportElement x="330" y="110" width="205" height="14"/>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <text><![CDATA[La Marocaine Vie]]></text>
            </staticText>
            <!-- Signature / cachet (partagée avec le template bancass) -->
            <image>
                <reportElement x="330" y="128" width="205" height="70"/>
                <imageExpression><![CDATA[getClass().getResourceAsStream("/templates/images/signature.png")]]></imageExpression>
            </image>
        </band>
    </summary>

</jasperReport>
