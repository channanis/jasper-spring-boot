@PostMapping("/generate")
    public ResponseEntity<byte[]> generate(@Valid @RequestBody DocumentGenerationRequest request) {
        DocumentGeneratorStrategy strategy = registry.resolve(request.code());

        GeneratedDocument document = strategy.generate(request.data(), request.format());

        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.parseMediaType(document.format().contentType()));
        headers.setContentDisposition(
                ContentDisposition.attachment().filename(document.fileName()).build()
        );

        return ResponseEntity.ok()
                .headers(headers)
                .body(document.content());
    }
public enum DocumentFormat {
    PDF("application/pdf", "pdf"),
    XLSX("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "xlsx"),
    DOCX("application/vnd.openxmlformats-officedocument.wordprocessingml.document", "docx");

    private final String contentType;
    private final String extension;}

public record DocumentGenerationRequest(

        @NotBlank(message = "le code du document est obligatoire")
        String code,

        DocumentFormat format,

        @NotNull(message = "data ne doit pas être null (utiliser {} si vide)")
        Map<String, Object> data
) {
    public DocumentGenerationRequest {
        if (format == null) {
            format = DocumentFormat.PDF;
        }
    }
}

public record GeneratedDocument(byte[] content, String fileName, DocumentFormat format) {
}

