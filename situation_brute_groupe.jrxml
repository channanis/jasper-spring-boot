<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="situation_brute_groupe"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30"
              uuid="d4e5f6a7-b8c9-40d1-2e3f-4a5b6c7d8e9f">

    <!-- Document mono-page, sans liste répétée : le Strategy passe une Collection à 1 élément
         (ex. List.of(new Object())) pour que la bande "detail" s'imprime exactement une fois. -->
    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>

    <!-- ===================== PARAMETRES ===================== -->
    <parameter name="nomAssure" class="java.lang.String"/>
    <parameter name="adresse1Assure" class="java.lang.String"/>
    <parameter name="adresse2Assure" class="java.lang.String"/>
    <parameter name="villeAssure" class="java.lang.String"/>
    <parameter name="nomContractant" class="java.lang.String"/>
    <parameter name="numeroCategorie" class="java.lang.String"/>
    <parameter name="police" class="java.lang.String"/>
    <parameter name="matricule" class="java.lang.String"/>
    <parameter name="dateSysteme" class="java.lang.String"/>
    <parameter name="derniereEcheanceCapitalisee" class="java.lang.String"/>
    <!-- Montant net cité dans le paragraphe d'intro (placeholder [@Net] du modèle d'origine) -->
    <parameter name="montantNet" class="java.math.BigDecimal"/>
    <parameter name="sommeCotisationPeriode" class="java.math.BigDecimal"/>
    <parameter name="sommeCotisationPatronale" class="java.math.BigDecimal"/>
    <parameter name="sommeCotisationSalariale" class="java.math.BigDecimal"/>
    <parameter name="montantAvanceNonRemboursee" class="java.math.BigDecimal"/>
    <parameter name="montant" class="java.math.BigDecimal"/>

    <!-- ===================== DETAIL : tout le document (imprimé une seule fois) ===================== -->
    <detail>
        <band height="720">

            <!-- Logo -->
            <image>
                <reportElement x="0" y="0" width="180" height="50"/>
                <imageExpression><![CDATA[getClass().getResourceAsStream("/templates/images/logo.png")]]></imageExpression>
            </image>

            <!-- Date -->
            <textField>
                <reportElement x="0" y="60" width="300" height="14"/>
                <textFieldExpression><![CDATA["Casablanca, le " + $P{dateSysteme}]]></textFieldExpression>
            </textField>

            <!-- Votre interlocuteur (gauche) -->
            <staticText>
                <reportElement x="0" y="85" width="200" height="14"/>
                <text><![CDATA[Votre interlocuteur :]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="99" width="250" height="14"/>
                <text><![CDATA[Service Relation Clients]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="113" width="300" height="14"/>
                <text><![CDATA[Tél : 05 22 26 36 36 (du lundi au vendredi de 8h à 16h30)]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="127" width="300" height="14"/>
                <text><![CDATA[E-mail : relationclient.lmv@lamarocainevie.com]]></text>
            </staticText>

            <!-- Bloc destinataire (droite) : NOMASS / ADR1ASS / ADR2ASS / NOMVIL -->
            <textField>
                <reportElement x="330" y="85" width="205" height="15"/>
                <textFieldExpression><![CDATA[$P{nomAssure}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="100" width="205" height="15"/>
                <textFieldExpression><![CDATA[$P{adresse1Assure} + ","]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="115" width="205" height="15"/>
                <textFieldExpression><![CDATA[$P{adresse2Assure} + ","]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="130" width="205" height="15"/>
                <textFieldExpression><![CDATA[$P{villeAssure}]]></textFieldExpression>
            </textField>

            <!-- Contractant / Police / Objet -->
            <textField>
                <reportElement x="0" y="180" width="535" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Contractant :        " + $P{nomContractant}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="200" width="535" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Police n° :        " + $P{numeroCategorie} + " " + $P{police} + " " + $P{matricule}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="220" width="535" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["OBJET :        Situation brute au " + $P{dateSysteme}]]></textFieldExpression>
            </textField>

            <!-- Corps de lettre -->
            <staticText>
                <reportElement x="0" y="255" width="535" height="14"/>
                <text><![CDATA[Monsieur/Madame,]]></text>
            </staticText>
            <textField isStretchWithOverflow="true" pattern="#,##0.00">
                <reportElement x="0" y="271" width="535" height="45"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Nous faisons suite à votre demande, et vous informons que compte tenu de la dernière échéance payée le " + $P{derniereEcheanceCapitalisee} + ", la situation brute de la police citée en objet est de " + ($P{montantNet} == null ? "" : $P{montantNet}.toPlainString()) + " dh (*) détaillée comme suit :"]]></textFieldExpression>
            </textField>

            <!-- Tableau montants -->
            <rectangle>
                <reportElement x="0" y="325" width="535" height="100"/>
            </rectangle>
            <line>
                <reportElement x="260" y="325" width="0" height="100"/>
            </line>
            <line>
                <reportElement x="440" y="325" width="0" height="100"/>
            </line>
            <line>
                <reportElement x="0" y="345" width="535" height="0"/>
            </line>
            <line>
                <reportElement x="0" y="365" width="535" height="0"/>
            </line>
            <line>
                <reportElement x="0" y="385" width="535" height="0"/>
            </line>
            <line>
                <reportElement x="0" y="405" width="535" height="0"/>
            </line>

            <staticText>
                <reportElement x="5" y="325" width="250" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Cotisation totale dont :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="265" y="325" width="170" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{sommeCotisationPeriode}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="445" y="325" width="85" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[DH]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="345" width="235" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[- Cotisation patronale :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="265" y="345" width="170" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{sommeCotisationPatronale}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="445" y="345" width="85" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[DH]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="365" width="235" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[- Cotisation salariale :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="265" y="365" width="170" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{sommeCotisationSalariale}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="445" y="365" width="85" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[DH]]></text>
            </staticText>

            <staticText>
                <reportElement x="5" y="385" width="250" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Avance non remboursée :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="265" y="385" width="170" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montantAvanceNonRemboursee}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="445" y="385" width="85" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[DH]]></text>
            </staticText>

            <staticText>
                <reportElement x="5" y="405" width="250" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Situation brute (**) :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="265" y="405" width="170" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{montant}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="445" y="405" width="85" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[DH]]></text>
            </staticText>

            <!-- Formule de politesse -->
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="440" width="535" height="30"/>
                <text><![CDATA[Nous vous en souhaitons bonne réception, et vous prions d'agréer, Monsieur, l'expression de nos sincères salutations.]]></text>
            </textField>

            <staticText>
                <reportElement x="0" y="480" width="535" height="14"/>
                <textElement><font isItalic="true" size="9"/></textElement>
                <text><![CDATA[(*) Sauf erreur ou omission de notre part.]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="496" width="535" height="14"/>
                <textElement><font isItalic="true" size="9"/></textElement>
                <text><![CDATA[(**) Cette situation brute ne tient pas compte de la retenue de l'IR et de la pénalité de rachat.]]></text>
            </staticText>

            <!-- Signature -->
            <staticText>
                <reportElement x="330" y="545" width="205" height="14"/>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <text><![CDATA[Département Relations Clients
La Marocaine Vie]]></text>
            </staticText>
            <image>
                <reportElement x="330" y="575" width="205" height="70"/>
                <imageExpression><![CDATA[getClass().getResourceAsStream("/templates/images/signature.png")]]></imageExpression>
            </image>

            <!-- Pied de page -->
            <staticText>
                <reportElement x="0" y="655" width="200" height="12"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[C0 - PUBLIC]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="669" width="535" height="0"/>
            </line>
            <staticText>
                <reportElement x="0" y="675" width="180" height="50"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[37, Boulevard Moulay Youssef
Casablanca
Maroc]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="675" width="180" height="50"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[Tél : (212) 05 22 43 11 00
Fax : (212) 05 22 26 19 71
lamarocainevie@lamarocainevie.com
www.lamarocainevie.com]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="675" width="175" height="60"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[Entreprise régie par la loi n°17-99 portant code des assurances
Société Anonyme au Capital de : 231.750.000 DH - RC 36 675
Patente 35504343 - CNSS 177 5652
Identification Fiscale 01085220
ICE 001526699000053]]></text>
            </staticText>
        </band>
    </detail>

</jasperReport>
